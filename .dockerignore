# Built bundled-resource payloads are platform-specific (mac/win/linux binaries
# + Python venvs). They must NOT leak from the host into the Docker context —
# the image builds its own Linux payloads via `npm run predist`, and the build
# scripts skip-if-built, so a stale mac payload would ship mac binaries in a
# linux image (Postgres/Python crash at runtime). The tracked seed file
# resources/litellm/default-config.yaml is NOT excluded (build-python-litellm.js
# + verify-bundle.js require it).
resources/node
resources/python
resources/postgres
resources/openconnector
resources/litellm/venv
resources/litellm/prisma-engine
# Leftover build archives (resources/python.tar.gz, resources/postgres/*.tgz,
# resources/node/*.tar.gz) are created then deleted by the build scripts; exclude
# any that linger from an interrupted host build. The tracked 9-byte
# resources/python.tar.xz placeholder is harmless and unused at build time.
resources/**/*.tar.gz
resources/**/*.tgz
resources/**/*.tar.xz
