# Copy this file to .env and fill in LLM_API_KEY. Everything else is
# preconfigured for the project's bundled LOCAL LiteLLM + OpenConnector:
# `npm start` spawns them on localhost:4000 / localhost:3001 alongside server.js.

# Self-hosted OpenAI-compatible gateway - the upstream LLM provider the local
# LiteLLM proxies to. Put YOUR key here. Without it, the local LiteLLM starts
# but chat calls to the gateway will fail with a quota/auth error.
LLM_API_KEY=sk-your-key
LLM_BASE_URL=http://your-gateway:port

# Default chat model (must be one of the model_name's in litellm.yaml)
DEFAULT_MODEL=deepseek-v4-pro

# Project-internal services. `npm start` spawns the bundled LiteLLM and
# OpenConnector - the port in the URL is PREFERRED; if it's already in use by
# another service on your machine, the launcher falls back to a free port (and
# logs it), so there's no conflict. server.js always gets the actual URL. Set a
# non-localhost URL to use a remote server instead. LITELLM_API_KEY and the
# OpenConnector tokens are AUTO-GENERATED into dev-settings.json (gitignored) on
# first run - leave them empty here.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=
OPENCONNECTOR_BASE_URL=http://localhost:3001
OPENCONNECTOR_RUNTIME_TOKEN=
OPENCONNECTOR_ADMIN_TOKEN=

# Upstream endpoint + credentials for the bundled LiteLLM's plan models
# (referenced by litellm.yaml via os.environ/). Any OpenAI-compatible
# endpoint works - no specific provider is required. Two keys allow rotation.
# The legacy VOLCES_PLAN_* names are still accepted as a fallback.
# LLM_UPSTREAM_BASE_URL=https://your-upstream-endpoint/v1
# LLM_UPSTREAM_KEY_1=
# LLM_UPSTREAM_KEY_2=

# Document collection (LlamaIndex.TS + PageIndex) model. Defaults to the same
# family used for chat; override with DOCUMENTS_MODEL. Must be a model id
# registered on the configured provider above.
# DOCUMENTS_MODEL=deepseek-v4-pro

# ── Optional login (forward-auth) ────────────────────────────────────────────
# AUTH_MODE=forward_auth trusts proxy-injected X-Forwarded-Email /
# X-Forwarded-Groups headers (Caddy forward_auth → oauth2-proxy → Logto).
# TRUST BOUNDARY: enabling it asserts the server is reachable ONLY through the
# forward-auth proxy — bind HOST to localhost or firewall it, otherwise the
# identity headers are attacker-controlled. Unset = open access (default; the
# desktop/Electron app always runs this way).
# AUTH_MODE=forward_auth

# ── Agent & app catalog (template: agents.example.json) ─────────────────────
# Local catalog = agents.json (sibling of mcp.json, gitignored). Cloud catalog
# = AGENTS_CONFIG_URL JSON, same schema; merged by id, cloud wins. Refreshed
# every CATALOG_REFRESH_SECS (and via POST /api/catalog/refresh). A cloud
# outage keeps the last-good entries.
# AGENTS_CONFIG_URL=https://example.com/agents.json
# CATALOG_REFRESH_SECS=60
# Server-side Nango secret for app entries of kind "nango-connect" (never sent
# to the browser).
# NANGO_SECRET_KEY=
