{
  "type": "module",
  "name": "platform",
  "version": "1.3.0",
  "description": "Platform - browser-based AI assistant built on the DeepSeek Harness (dsh) runtime",
  "main": "electron/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "start:electron": "electron .",
    "predist": "node scripts/build-openconnector.js && node scripts/build-node.js && node scripts/verify-bundle.js",
    "dist": "npm run web:build && node node_modules/electron-builder/cli.js --publish never",
    "clean:bundle": "rm -rf resources/openconnector",
    "test:e2e": "playwright test --project=fast",
    "test:e2e:smoke": "playwright test --project=smoke",
    "test:e2e:live": "PW_LIVE=1 playwright test --project=live",
    "test:e2e:live:smoke": "PW_LIVE=1 LIVE_SMOKE=1 playwright test --project=live",
    "test:unit": "node --test scripts/test-*.mjs",
    "check:locales": "node scripts/check-locales.js",
    "lint": "biome check .",
    "typecheck": "npm --prefix web run typecheck",
    "web:install": "npm --prefix web install",
    "web:build": "npm run check:locales && npm --prefix web run build",
    "web:dev": "npm --prefix web run dev",
    "postinstall": "node scripts/postinstall-web.js && node scripts/postinstall-bundle.js"
  },
  "dependencies": {
    "@deepseek-ai/dsh-sdk-client": "^0.0.1-rc.1",
    "@llamaindex/openai": "latest",
    "@llamaindex/readers": "latest",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^13.0.2",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "llamaindex": "latest",
    "multer": "^2.2.0",
    "node-schedule": "^2.1.1",
    "officeparser": "^7.5.1",
    "pageindex": "^1.0.1",
    "undici": "latest",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@playwright/test": "latest",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "execa": "^10.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "platformBundles": {
    "openconnectorSha": "0dfc73e5f826f2efdcacf274347d7a8284b7d9dd"
  }
}
